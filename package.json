{
  "name": "piblo-prototype",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Piblo Socratic tutor + analyzer loop prototype (photosynthesis)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package-worker.mjs",
    "start": "vite preview",
    "demo": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env --experimental-strip-types src/demo.ts",
    "chat": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env --experimental-strip-types src/harness.ts",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.17",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  }
}
