{
  "name": "piblo",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Piblo is an adaptive learning app built around a Socratic tutor and a learner-model analyzer.",
  "contributors": [
    "Sarthak Verma <sarthak.verma@gmail.com>",
    "Vaishnavi Koshti <vaishnavi.koshti@gmail.com>"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env --experimental-strip-types src/demo.ts",
    "chat": "node --env-file-if-exists=.env --env-file-if-exists=../../../.env --experimental-strip-types src/harness.ts",
    "test": "node --test --experimental-strip-types 'domain/**/*.test.ts' 'features/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/postcss": "^4.3.3",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^7.0.2"
  }
}
